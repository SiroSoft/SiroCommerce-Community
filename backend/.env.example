APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
# Public storefront origin used in password-reset/verification links; falls back
# to APP_URL when empty.
STOREFRONT_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Commercial edition feature flags. PRO_EDITION must be community|pro|enterprise;
# unknown values fail closed to community. PRO_FEATURES is a comma-separated
# allowlist honored only on pro/enterprise. Community always exposes all flags as
# false. Valid flags:
# multi_store_theming,marketplace,sso,enterprise_audit,ai_managed,white_label
PRO_EDITION=community
PRO_FEATURES=
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# MySQL settings used by deploy/docker-compose.yml (compose overrides
# DB_CONNECTION/DB_HOST/DB_PORT). DB_ROOT_PASSWORD is only for the MySQL
# container; never reuse it for application traffic.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=
TEST_DB_DRIVER=sqlite
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=sirocommerce_test
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=
# Browser origins allowed to call the API (comma-separated, exact match).
# `*` keeps the legacy behaviour: any origin is echoed for responses without
# credentials. Set explicit origins (e.g. https://admin.example.com) to block
# unknown origins and allow credentialed requests.
CORS_ALLOWED_ORIGINS=*
# Baseline CORS response contract; override only if a browser client needs a
# different method/header set. Keep credentials disabled with a `*` allowlist.
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Request-Id
# Upload hardening: maximum accepted image bytes (default 8MB). SVG is always
# rejected by UploadController; only JPEG/PNG/WebP/AVIF are accepted.
# Keep MAX_BODY_SIZE_MB (core Request body cap) >= UPLOAD_MAX_BYTES/1MB (8 here),
# otherwise larger uploads are rejected by the HTTP layer before validation.
# The nginx deploy configs allow client_max_body_size 12m.
UPLOAD_MAX_BYTES=8388608
MAX_BODY_SIZE_MB=10
# Digital delivery transport: the root must stay outside the web root (or be
# empty to disable local delivery); the byte cap defaults to 50MB.
DIGITAL_DELIVERY_ROOT=
DIGITAL_DELIVERY_MAX_BYTES=52428800
# Per-IP write budgets (requests/minute). Storefront writes and the admin
# mutation backstop both default to 120; webhooks and health are never throttled.
THROTTLE_STOREFRONT_READ=3000
THROTTLE_STOREFRONT_WRITE=120
THROTTLE_WRITE_DEFAULT=120
JWT_SECRET=change-me-to-at-least-32-characters-long
# Prometheus scrape token for GET /metrics.
# When set, scrapers must send `Authorization: Bearer <token>` or
# `X-Metrics-Token: <token>` (401 missing, 403 wrong). When unset, /metrics is
# only served outside production; production returns 404 to avoid leaking
# operational data from an unconfigured deployment.
METRICS_TOKEN=
# Frontend trust. Storefront requests may authenticate by exact Origin/Referer
# match against this allowlist (comma-separated, no wildcards).
FE_ALLOWED_ORIGINS=https://ecommerce.sirophp.com,https://admin.sirophp.com,http://localhost:3000,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3005
# Optional/deprecated legacy token for nginx-injected and admin traffic.
# NEXT_PUBLIC_FE_TOKEN is inlined into browser bundles, so it is NOT a secret;
# keep any real shared secret server-side (nginx X-Siro-FE) instead.
FE_SHARED_SECRET=
ERP_LITE_URL=
ERP_WEBHOOK_SECRET=
# Legacy aliases honored by ErpLiteClient/ErpWebhookController when the
# ERP_WEBHOOK_SECRET above is empty.
ERP_LITE_SECRET=
ERP_STORE_ID=default
ERP_CHANNEL_ID=web
DEMO_EMAIL=demo@sirocommerce.local
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Transactional email (password reset, email verification) via raw SMTP.
# Leave unset to stay silent (endpoints keep answering generically).
# Gmail example: HOST=smtp.gmail.com PORT=587 ENCRYPTION=tls + an App Password.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_TIMEOUT=5
# MAIL_PROVIDER=null disables sending; any other value uses the SMTP settings
# above. MAIL_FROM_ADDRESS is an alias for MAIL_FROM.
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SiroCommerce
PAYMENT_MODE=sandbox
PAYMENT_DEFAULT_PROVIDER=stripe
# Payment launch gate controls. Live certification is never inferred from credentials alone.
PAYMENT_CERTIFICATION_SANDBOX=1
PAYMENT_CERTIFICATION_LIVE=0
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_PAYPAL_ACCESS_TOKEN=
PAYMENT_PAYPAL_WEBHOOK_SECRET=
PAYMENT_ADYEN_API_KEY=
PAYMENT_ADYEN_WEBHOOK_SECRET=
PAYMENT_AUTHORIZENET_API_KEY=
PAYMENT_AUTHORIZENET_WEBHOOK_SECRET=
PAYMENT_SQUARE_ACCESS_TOKEN=
PAYMENT_SQUARE_WEBHOOK_SECRET=
# Vietnam payment providers. PAYMENT_MODE selects sandbox/production gateway URLs.
# VNPay sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# MoMo sandbox: https://test-payment.momo.vn (set MOMO_API_URL to override).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=
TRANSACTIONAL_MESSAGE_PROVIDER=native
TRANSACTIONAL_MESSAGE_MODE=sandbox

# Production DHL configuration. DHL_MODE=sandbox is local-only.
DHL_MODE=sandbox
DHL_API_URL=
DHL_API_KEY=
DHL_API_SECRET=
DHL_WEBHOOK_SECRET=
DHL_HTTP_TIMEOUT=15
DHL_HTTP_RETRIES=2
PAYMENT_HTTP_TIMEOUT=15
PAYMENT_HTTP_RETRIES=2
TAX_PROVIDER=native
# Storefront shipping estimate (PDP). SHIPPING_PROVIDER=native|dhl|ghn|viettelpost.
# Native rules remain the deterministic fallback when a carrier errors.
SHIPPING_PROVIDER=native
# GHN sandbox/production gateway. GHN_API_URL overrides the environment default.
GHN_ENV=sandbox
GHN_API_URL=
GHN_TOKEN=
GHN_SHOP_ID=
# ViettelPost partner API. Point VIETTELPOST_API_URL at the sandbox host when testing.
VIETTELPOST_API_URL=https://partner.viettelpost.vn
VIETTELPOST_USERNAME=
VIETTELPOST_PASSWORD=
# Provider-readiness flag: dhl|ghn|viettelpost enables the matching live readiness check.
SHIPPING_DEFAULT_PROVIDER=native
SHIPPING_DEFAULT_WEIGHT_G=300
SHIPPING_ORIGIN_COUNTRY=VN
SHIPPING_ORIGIN_REGION=HN
SHIPPING_ORIGIN_POSTAL_CODE=100000
SHIPPING_FLAT_RATE_MINOR=30000
SHIPPING_EXPRESS_RATE_MINOR=60000
SHIPPING_ETA_MIN_DAYS=2
SHIPPING_ETA_MAX_DAYS=4
SHIPPING_INTL_MULTIPLIER=3
SHIPPING_FREE_OVER_MINOR=1500000
PROVIDER_LIVE_SMOKE=0
SHIPPING_LIVE_SMOKE_URL=
SHIPPING_LIVE_SMOKE_WEBHOOK_URL=
TAX_LIVE_SMOKE_URL=
TAX_LIVE_SMOKE_WEBHOOK_URL=
SEARCH_PROVIDER=native
SEARCH_INDEX_VERSION=catalog-v1
SEARCH_MAX_LAG_SECONDS=20
SEARCH_TYPO_TOLERANCE=1
SEARCH_SYNONYMS=
SEARCH_RANKING={"text":60,"exact":25,"freshness":10,"availability":5}
SEARCH_URL=
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=2
# Storefront catalog search: native (default, SQL) or meili. When meili is set,
# SEARCH_URL/SEARCH_API_KEY must point at the Meilisearch index managed by
# `php siro search:index-products --fresh` (see docs/engineering/SEARCH_MEILI.md).
CATALOG_SEARCH_PROVIDER=native
# Master key for deploy/docker-compose.yml's meilisearch service. Change it
# outside local development; it is also injected as SEARCH_API_KEY in compose.
MEILI_MASTER_KEY=sirocommerce-dev-meili-key-change-me

# Ops intelligence: POST JSON {kind, observed, baseline_x100, ratio_x100, at}
# when an anomaly first opens (refund/payment/fulfillment spikes). Best-effort,
# 3s timeout, never blocks aggregation. Leave empty to disable.
OPS_ALERT_WEBHOOK_URL=

# LLM gateway (P4.9). AI_PROVIDER=unavailable|openai|ollama. Default closed.
AI_PROVIDER=unavailable
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4096
AI_BUDGET_MINOR=0
# Comma-separated answer languages for the read-only assistants. English is
# always the translation pivot; unknown target locales fall back to English.
ASSISTANT_LANGUAGES=en,vi,ja,de,zh

