{
  "name": "@sirocommerce/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-source.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:e2e": "playwright test -c playwright.quality.config.ts",
    "test:e2e:ci": "playwright test -c playwright.quality.config.ts --grep-invert \"visual baseline\" --reporter=line",
    "test:e2e:mobile": "playwright test -c playwright.quality.config.ts --project=mobile",
    "test:e2e:full": "playwright test",
    "test:e2e:live": "node scripts/e2e-quality-live.mjs",
    "qa:visual": "playwright test -c playwright.quality.config.ts --grep visual",
    "qa:visual:update": "playwright test -c playwright.quality.config.ts --grep visual --update-snapshots",
    "i18n:check": "node scripts/check-i18n.mjs",
    "qa:images": "node scripts/check-image-contract.mjs",
    "budget": "node scripts/check-bundle-budget.mjs --total-kb 400 --chunk-kb 100",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
