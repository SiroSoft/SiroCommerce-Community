{
    "name": "sirosoft/commerce",
    "description": "SiroCommerce — flagship commerce platform on SiroPHP Core (Siro framework backend)",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "sirosoft/core": "^1.3.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.50",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "generate:openapi": "php scripts/generate-openapi.php",
        "generate:sdk": "php scripts/generate-sdk.php",
        "check:api-contract": "php scripts/check-api-contract.php",
        "check:api-breaking": "php scripts/check-api-breaking.php",
        "merge:api-evidence": "php scripts/merge-api-evidence.php",
        "handoff:matrix": "php scripts/build-api-handoff-matrix.php",
        "check:api-handoff": "php scripts/check-api-handoff.php",
        "check:production-proof": "php scripts/check-production-proof.php",
        "check:certification": "php scripts/check-certification.php",
        "certify:providers": "php scripts/run-provider-certification.php",
        "certify:payment": "php scripts/certify-payment.php",
        "check:evidence": "php scripts/check-evidence.php",
        "seed:demo": "php scripts/seed-demo.php",
        "seed:b2c": "php scripts/seed-b2c.php",
        "test:unit": "php vendor/bin/phpunit --testsuite unit --no-coverage",
        "test:integration": "php vendor/bin/phpunit --testsuite integration --no-coverage",
        "test:api": "php vendor/bin/phpunit --testsuite api --no-coverage",
        "test:workflow": "php vendor/bin/phpunit --testsuite workflow --no-coverage",
        "test:groups": "php scripts/run-test-groups.php",
        "test": "php vendor/bin/phpunit --no-coverage",
        "analyse": "php vendor/bin/phpstan analyse --level=max --no-progress",
        "phpstan": "php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress",
        "phpstan:baseline": "php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress --generate-baseline=phpstan-baseline.neon",
        "check": [
            "php vendor/bin/phpstan analyse --level=max --no-progress",
            "php vendor/bin/phpunit --no-coverage",
            "@check:api-contract",
            "@check:api-handoff"
        ]
    }
}
